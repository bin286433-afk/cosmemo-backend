PROJECT_NAME="CosMemo API"
API_V1_STR="/api/v1"
# 배포 전 반드시 변경: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="cosmemo-super-secret-jwt-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL="sqlite:///./cosmemo.db"
# 쉼표로 구분. "*" 이면 모든 출처 허용(시연용)
CORS_ORIGINS="*"

# 시연 모드: 토큰 없이 호출하면 시드 사용자(지윤)로 동작. 실제 서비스에서는 false
DEMO_MODE=true
# 시연 기준일. 비우면("") 실제 오늘 날짜로 D-Day 계산
REFERENCE_DATE="2026-10-30"

# --- 알림 스케줄러 ---
TZ_OFFSET_HOURS=9
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
EVALUATION_REMINDER_DAYS=14
PASSWORD_RESET_MINUTES=30

# --- 영수증 OCR ---
# Google AI Studio(https://aistudio.google.com/) 에서 발급한 키를 넣으면 실제 영수증 사진 인식이 동작합니다.
GEMINI_API_KEY=""
# gemini-1.5-flash 는 서비스 종료됨. 사용 가능한 모델명은 AI Studio 문서에서 확인
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_TIMEOUT_SECONDS=30
# pytesseract + Tesseract(kor) 가 설치되어 있으면 Gemini 실패 시 로컬 OCR 로 재시도
ENABLE_TESSERACT=true
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
CATALOG_MATCH_THRESHOLD=0.62
